{
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run test:audit)",
      "Bash(node bin/doit.js:*)"
    ],
    "deny": [
      "Read(/node_modules/**)",
      "Read(/test/tmp/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/Tools/Claude/read_guard.py\""
          }
        ]
      }
    ]
  }
}
